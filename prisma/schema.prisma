generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
}

model DailyUsage {
  id         String   @id @default(uuid())
  userId     String
  commandKey String
  count      Int
  resetAt    DateTime

  @@unique([userId, commandKey])
}
