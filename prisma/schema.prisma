generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
}

model DailyUsage {
  id         String   @id @default(uuid())
  userId     String
  commandKey String
  count      Int
  resetAt    DateTime

  @@unique([userId, commandKey])
}

model GuildConfig {
  guildId             String  @id
  mentionLinksEnabled Boolean @default(false)
}

model Welcome {
  id        String @id @default(uuid())
  guildId   String
  channelId String
  message   String

  @@unique([guildId, channelId])
}

model Leave {
  id        String @id @default(uuid())
  guildId   String
  channelId String
  message   String

  @@unique([guildId, channelId])
}
