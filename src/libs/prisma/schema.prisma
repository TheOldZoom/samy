generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id

  locale String?

  prefix String?

  timezone String?
  birthday DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastfm LastFM?
  afks   Afk[]
}

model LastFM {
  id String @id @default(cuid())

  username String

  connectedAt DateTime @default(now())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guild {
  id String @id

  locale String?

  prefix String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  welcomes               Welcome[]
  leaves                 Leave[]
  commandSettings        CommandSetting[]
  afks                   Afk[]
  guildBans              GuildBan[]
  warnings               Warning[]
  memberNotes            MemberNote[]
  modCases               ModerationCase[]
  lockdownChannels       LockdownChannel[]
  lockdownRoles          LockdownRole[]
  lockdown               Lockdown?
  logChannels            LogChannel[]
  logIgnores             LogIgnore[]
  commandAliases         CommandAlias[]
  commandRestrictions    CommandRestriction[]
  channelCommandSettings ChannelCommandSetting[]
  memberCommandSettings  MemberCommandSetting[]
  fakePermissions        FakePermission[]
  markovChain            MarkovChain?
  markovSettings         MarkovSettings?
  markovChannels         MarkovChannel[]
  autoroles              Autorole[]
  stickyRoles            StickyRole[]
  temporaryRoles         TemporaryRole[]
}

model GuildBan {
  id String @id @default(cuid())

  guildId String
  userId  String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([expiresAt])
  @@index([guildId])
}

model CommandSetting {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  command String

  enabled Boolean @default(true)

  @@unique([guildId, command])
  @@index([guildId])
}

model Welcome {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  message String @db.Text()

  @@unique([guildId, channelId])
  @@index([guildId])
  @@index([channelId])
}

model Leave {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  message String @db.Text()

  @@unique([guildId, channelId])
  @@index([guildId])
  @@index([channelId])
}

model Afk {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}

model Warning {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId      String
  moderatorId String

  reason    String   @db.Text()
  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId])
}

model MemberNote {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId      String
  moderatorId String

  content   String   @db.Text()
  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId])
}

model ModerationCase {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  caseNumber  Int
  type        String
  userId      String
  moderatorId String

  reason    String?
  duration  Int?
  expiresAt DateTime?

  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
  @@index([guildId])
}

model LockdownChannel {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  createdAt DateTime @default(now())

  @@unique([guildId, channelId])
  @@index([guildId])
}

model LockdownRole {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  roleId String

  createdAt DateTime @default(now())

  @@unique([guildId, roleId])
  @@index([guildId])
}

model Lockdown {
  id String @id @default(cuid())

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  active Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LogCategory {
  ALL
  CHANNELS
  GUILD
  IMAGES
  MEMBERS
  MESSAGES
  MODERATION
  ROLES
  VOICE
}

enum IgnoreTargetType {
  USER
  ROLE
  CHANNEL
}

model LogChannel {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  category  LogCategory
  channelId String

  webhookId    String?
  webhookToken String?

  createdAt DateTime @default(now())

  @@unique([guildId, category])
  @@index([guildId])
}

model LogIgnore {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  targetId   String
  targetType IgnoreTargetType

  category LogCategory

  createdAt DateTime @default(now())

  @@unique([guildId, targetId, category])
  @@index([guildId])
}

model CommandAlias {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  alias   String
  command String

  createdAt DateTime @default(now())

  @@unique([guildId, alias])
  @@index([guildId])
}

model CommandRestriction {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  command String
  roleId  String

  createdAt DateTime @default(now())

  @@unique([guildId, command, roleId])
  @@index([guildId])
}

model ChannelCommandSetting {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String
  command   String
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId, command])
  @@index([guildId])
  @@index([channelId])
}

model MemberCommandSetting {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId  String
  command String
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, command])
  @@index([guildId])
  @@index([userId])
}

model FakePermission {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  roleId     String
  permission String

  createdAt DateTime @default(now())

  @@unique([guildId, roleId, permission])
  @@index([guildId])
  @@index([roleId])
}

model SamyImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  createdAt DateTime @default(now())
}

model MarkovChain {
  id String @id @default(cuid())

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  data         String @db.Text()
  messageCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarkovSettings {
  id String @id @default(cuid())

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled        Boolean @default(false)
  mentionEnabled Boolean @default(true)

  randomEnabled   Boolean @default(false)
  randomFrequency Int     @default(200)
  randomCooldown  Int     @default(300)

  chainOrder Int @default(2)

  minOutputLength Int @default(3)
  maxOutputLength Int @default(25)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarkovChannel {
  id String @id @default(cuid())

  guildId String
  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  createdAt DateTime @default(now())

  @@unique([guildId, channelId])
  @@index([guildId])
  @@index([channelId])
}

model Autorole {
  id String @id @default(cuid())

  guildId String
  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  roleId String

  createdAt DateTime @default(now())

  @@unique([guildId, roleId])
  @@index([guildId])
  @@index([roleId])
}

model StickyRole {
  id String @id @default(cuid())

  guildId String
  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId  String
  roleId  String

  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([guildId])
  @@index([guildId, userId])
  @@index([roleId])
}

model TemporaryRole {
  id String @id @default(cuid())

  guildId String
  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId  String
  roleId  String

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([expiresAt])
  @@index([guildId])
  @@index([guildId, userId])
}
